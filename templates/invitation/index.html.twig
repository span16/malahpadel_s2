{% extends 'base.html.twig' %}

{% block title %}Invitations{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Invitations</h5>
            
            {% if is_logged_in %}
                <a href="{{ path('app_invitation_new') }}" class="btn btn-primary mb-3">Create New Invitation</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-primary mb-3">Login to Create Invitation</a>
            {% endif %}

            <table class="table">
                <thead>
                    <tr>
                        <th>From</th>
                        <th>To</th>
                        <th>Message</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for invitation in invitations %}
                    <tr>
                        <td>{{ invitation.senderEmail }}</td>
                        <td>{{ invitation.receiverEmail }}</td>
                        <td>{{ invitation.message }}</td>
                        <td>{{ invitation.statut }}</td>
                        <td>{{ invitation.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td>
                            <a href="{{ path('app_invitation_show', {'id': invitation.id}) }}" class="btn btn-info btn-sm">Show</a>
                            {% if is_logged_in and app.user.email == invitation.senderEmail %}
                                <a href="{{ path('app_invitation_edit', {'id': invitation.id}) }}" class="btn btn-warning btn-sm">Edit</a>
                                <form method="post" action="{{ path('app_invitation_delete', {'id': invitation.id}) }}" style="display: inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invitation.id) }}">
                                    <button class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this invitation?')">Delete</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">No invitations found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %} 