{% extends 'base.html.twig' %}

{% block title %}Invitation Details{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Invitation Details</h5>

            <table class="table">
                <tbody>
                    <tr>
                        <th>From</th>
                        <td>{{ invitation.senderEmail }}</td>
                    </tr>
                    <tr>
                        <th>To</th>
                        <td>{{ invitation.receiverEmail }}</td>
                    </tr>
                    <tr>
                        <th>Message</th>
                        <td>{{ invitation.message }}</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>{{ invitation.statut }}</td>
                    </tr>
                    <tr>
                        <th>Date</th>
                        <td>{{ invitation.createdAt|date('Y-m-d H:i:s') }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-3">
                {% if app.user and app.user.email == invitation.receiverEmail and invitation.statut == 'en_attente' %}
                    <a href="{{ path('app_invitation_accepter', {'id': invitation.id}) }}" class="btn btn-success">Accept</a>
                    <a href="{{ path('app_invitation_refuser', {'id': invitation.id}) }}" class="btn btn-danger">Refuse</a>
                {% endif %}
                
                {% if app.user and app.user.email == invitation.senderEmail %}
                    <a href="{{ path('app_invitation_edit', {'id': invitation.id}) }}" class="btn btn-warning">Edit</a>
                    <form method="post" action="{{ path('app_invitation_delete', {'id': invitation.id}) }}" style="display: inline-block;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invitation.id) }}">
                        <button class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this invitation?')">Delete</button>
                    </form>
                {% endif %}
                
                <a href="{{ path('app_invitation_index') }}" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
{% endblock %} 