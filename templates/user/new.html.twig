{% extends 'back.html.twig' %}

{% block title %}Créer un utilisateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm p-4">
                <h2 class="text-center text-primary mb-4">Créer un nouvel utilisateur</h2>

                {% for flash in app.flashes('danger') %}
                    <div class="alert alert-danger">{{ flash }}</div>
                {% endfor %}
                {% for flash in app.flashes('success') %}
                    <div class="alert alert-success">{{ flash }}</div>
                {% endfor %}

                {{ form_start(form) }}

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.prenom) }}
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.prenom) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.age) }}
                        {{ form_widget(form.age, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.age) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.cin) }}
                        {{ form_widget(form.cin, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.cin) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.mdp) }}
                        {{ form_widget(form.mdp, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.mdp) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.etat) }}
                        {{ form_widget(form.etat, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.etat) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.fonction) }}
                        {{ form_widget(form.fonction, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.fonction) }}
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a href="{{ path('app_user_dashboard') }}" class="btn btn-secondary">← Retour</a>
                    <button class="btn btn-success" type="submit">✅ Créer</button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
