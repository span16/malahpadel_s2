    <script>
        window.addEventListener('load', function () {
            var calendarEl = document.getElementById('calendar');
            if (calendarEl) {
                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    locale: 'fr',
                    events: [
                        {
                            title: 'Match test',
                            start: '2025-04-15'
                        }
                    ]
                });
                calendar.render();
            } else {
                console.error("DIV #calendar non trouvé !");
            }
        });
    </script>
