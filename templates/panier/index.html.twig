{% extends 'base.html.twig' %}

{% block title %}Mon Panier - MALAH PADEL{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">Votre Panier</h1>
    
    {% if items|length > 0 %}
        <div class="table-responsive">
            <table class="table">
                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th>Prix unitaire</th>
                        <th>Quantité</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    {% if item.produit.imageProduit %}
                                        <img src="{{ asset('uploads/produits/' ~ item.produit.imageProduit) }}" 
                                             alt="{{ item.produit.nomProduit }}" 
                                             class="img-thumbnail me-3" 
                                             style="width: 80px; height: 80px; object-fit: cover;">
                                    {% endif %}
                                    <div>
                                        <h5 class="mb-1">{{ item.produit.nomProduit }}</h5>
                                        <span class="badge bg-{{ item.produit.stock > 10 ? 'success' : (item.produit.stock > 0 ? 'warning text-dark' : 'danger') }}">
                                            Stock: {{ item.produit.stock }}
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>{{ item.produit.prix|number_format(2, ',', ' ') }} €</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="mx-2">{{ item.quantite }}</span>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_panier_remove', {'id': item.produit.idProduit}) }}" 
                                           class="btn btn-outline-secondary">-</a>
                                        <a href="{{ path('app_panier_add', {'id': item.produit.idProduit}) }}" 
                                           class="btn btn-outline-secondary">+</a>
                                    </div>
                                </div>
                            </td>
                            <td>{{ item.sousTotal|number_format(2, ',', ' ') }} €</td>
                            <td>
                                <a href="{{ path('app_panier_remove_all', {'id': item.produit.idProduit}) }}" 
                                   class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Total :</td>
                        <td colspan="2" class="fw-bold">{{ total|number_format(2, ',', ' ') }} €</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_panier_clear') }}" class="btn btn-outline-danger">
                <i class="fas fa-trash me-1"></i> Vider le panier
            </a>
            <div>
                <a href="{{ path('app_produit_index') }}" class="btn btn-outline-primary me-2">
                    <i class="fas fa-arrow-left me-1"></i> Continuer mes achats
                </a>
                <a href="{{ path('app_checkout') }}" class="btn btn-primary">
                    <i class="fas fa-credit-card me-1"></i> Passer la commande
                </a>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            Votre panier est vide
        </div>
        <a href="{{ path('app_produit_index') }}" class="btn btn-primary">
            <i class="fas fa-arrow-left me-1"></i> Retour à la boutique
        </a>
    {% endif %}
</div>
{% endblock %}