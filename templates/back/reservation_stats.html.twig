{% extends 'back.html.twig' %}

{% block title %}Statistiques des Réservations{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Statistiques des Réservations</h4>
                <div class="chart-container" style="height: 400px;">
                    {{ render_chart(chart) }}
                </div>
                
                <div class="mt-4">
                    <a href="{{ path('admin_reservation_index') }}" class="btn btn-primary">
                        <i class="fas fa-arrow-left me-2"></i> Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('chart') }}
{% endblock %}