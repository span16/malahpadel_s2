{# templates/back/stats.html.twig #}

{% extends 'back.html.twig' %}

{% block title %}Statistiques des Réclamations{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .stat-card {
        transition: all 0.3s ease;
        min-height: 120px;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    canvas {
        min-height: 300px;
        width: 100% !important;
    }
    .badge-info { background-color: #17a2b8; }
    .badge-warning { background-color: #ffc107; color: #212529; }
    .badge-success { background-color: #28a745; }
    .progress {
        height: 6px;
    }
</style>
{% endblock %}

{% block body %}
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-4">Statistiques des Réclamations</h4>
                    
                    {# Cartes de statistiques #}
                    <div class="row">
                        <!-- Carte Totale -->
                        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                            <div class="card stat-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-muted font-weight-normal mb-2">Total</h6>
                                            <h2 class="mb-0">{{ stats.total }}</h2>
                                        </div>
                                        <div class="icon icon-box-primary rounded-circle">
                                            <span class="mdi mdi-alert-circle-outline icon-item"></span>
                                        </div>
                                    </div>
                                    <div class="progress mt-3">
                                        <div class="progress-bar bg-primary" style="width: 100%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Carte 7 derniers jours -->
                        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                            <div class="card stat-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-muted font-weight-normal mb-2">7 derniers jours</h6>
                                            <h2 class="mb-0">{{ stats.last7days }}</h2>
                                            {% set percentChange7 = stats.last30days > 0 ? (stats.last7days / (stats.last30days / 30 * 7) * 100) : 0 %}
                                            <p class="mb-0 mt-1 small {{ percentChange7 > 100 ? 'text-success' : 'text-danger' }}">
                                                <i class="mdi mdi-arrow-{{ percentChange7 > 100 ? 'up' : 'down' }}"></i>
                                                {{ percentChange7|round(1) }}%
                                            </p>
                                        </div>
                                        <div class="icon icon-box-{{ percentChange7 > 100 ? 'success' : 'danger' }} rounded-circle">
                                            <span class="mdi mdi-trending-{{ percentChange7 > 100 ? 'up' : 'down' }} icon-item"></span>
                                        </div>
                                    </div>
                                    <div class="progress mt-3">
                                        <div class="progress-bar bg-{{ percentChange7 > 100 ? 'success' : 'danger' }}" 
                                             style="width: {{ min(percentChange7, 100) }}%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Carte 30 derniers jours -->
                        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                            <div class="card stat-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-muted font-weight-normal mb-2">30 derniers jours</h6>
                                            <h2 class="mb-0">{{ stats.last30days }}</h2>
                                            <p class="mb-0 mt-1 small text-muted">
                                                Moyenne: {{ (stats.last30days / 30)|round(1) }}/jour
                                            </p>
                                        </div>
                                        <div class="icon icon-box-info rounded-circle">
                                            <span class="mdi mdi-calendar-month icon-item"></span>
                                        </div>
                                    </div>
                                    <div class="progress mt-3">
                                        <div class="progress-bar bg-info" 
                                             style="width: {{ stats.last30days > 0 ? min((stats.last30days / stats.total * 100), 100) : 0 }}%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Carte Non traitées -->
                        <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                            <div class="card stat-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-muted font-weight-normal mb-2">Non traitées</h6>
                                            <h2 class="mb-0">{{ stats.untreated }}</h2>
                                            <p class="mb-0 mt-1 small text-muted">
                                                {{ stats.total > 0 ? (stats.untreated / stats.total * 100)|round(1) : 0 }}% du total
                                            </p>
                                        </div>
                                        <div class="icon icon-box-warning rounded-circle">
                                            <span class="mdi mdi-alert icon-item"></span>
                                        </div>
                                    </div>
                                    <div class="progress mt-3">
                                        <div class="progress-bar bg-warning" 
                                             style="width: {{ stats.total > 0 ? (stats.untreated / stats.total * 100) : 0 }}%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Graphiques -->
                    <div class="row mt-4">
                        <!-- Répartition par statut -->
                        <div class="col-md-6 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title">Répartition par statut</h4>
                                    {% if stats.byStatus is empty %}
                                        <div class="alert alert-info">Aucune donnée disponible</div>
                                    {% else %}
                                        <canvas id="statusChart"></canvas>
                                        <div class="mt-4">
                                            {% for status in stats.byStatus %}
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span>
                                                        <span class="badge badge-{{ status.etat == 'Nouvelle' ? 'info' : (status.etat == 'En cours' ? 'warning' : 'success') }}">
                                                            {{ status.etat }}
                                                        </span>
                                                    </span>
                                                    <span>
                                                        {{ status.count }} ({{ stats.total > 0 ? (status.count / stats.total * 100)|round(1) : 0 }}%)
                                                    </span>
                                                </div>
                                                <div class="progress mb-3">
                                                    <div class="progress-bar bg-{{ status.etat == 'Nouvelle' ? 'info' : (status.etat == 'En cours' ? 'warning' : 'success') }}" 
                                                         style="width: {{ stats.total > 0 ? (status.count / stats.total * 100) : 0 }}%">
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        
                        <!-- Évolution mensuelle sous forme de diagramme circulaire -->
<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Répartition mensuelle</h4>
            {% if stats.monthlyTrend is empty %}
                <div class="alert alert-info">Aucune donnée disponible</div>
            {% else %}
                <canvas id="monthlyPieChart"></canvas>
                <div class="mt-3 text-center text-muted small">
                    Répartition sur les 12 derniers mois
                </div>
                
                <!-- Légende détaillée -->
                <div class="mt-3">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Mois</th>
                                <th>Nombre</th>
                                <th>Pourcentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set total = stats.monthlyTrend|reduce((sum, item) => sum + item.count, 0) %}
                            {% for item in stats.monthlyTrend %}
                            <tr>
                                <td>{{ item.month }}</td>
                                <td>{{ item.count }}</td>
                                <td>{{ total > 0 ? ((item.count / total) * 100)|round(1) ~ '%' : '0%' }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
                    
                    <!-- Dernières réclamations -->
                    <div class="row mt-4">
                        <div class="col-12 grid-margin">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h4 class="card-title mb-0">Dernières réclamations</h4>
                                        <a href="{{ path('admin_reclamation_index') }}" class="btn btn-sm btn-primary">
                                            Voir toutes
                                        </a>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Date</th>
                                                    <th>Statut</th>
                                                    <th>Raison</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for reclamation in stats.recent %}
                                                <tr>
                                                    <td>#{{ reclamation.id }}</td>
                                                    <td>{{ reclamation.date|date('d/m/Y H:i') }}</td>
                                                    <td>
                                                        <span class="badge badge-{{ 
                                                            reclamation.etat == 'Nouvelle' ? 'info' : 
                                                            (reclamation.etat == 'En cours' ? 'warning' : 'success') 
                                                        }}">
                                                            {{ reclamation.etat }}
                                                        </span>
                                                    </td>
                                                    <td>
                                                        {% if reclamation.raison %}
                                                            {{ reclamation.raison|length > 50 ? reclamation.raison|slice(0, 50) ~ '...' : reclamation.raison }}
                                                        {% else %}
                                                            <span class="text-muted">-</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('admin_reclamation_edit', {'id': reclamation.id}) }}" 
                                                           class="btn btn-sm btn-outline-primary"
                                                           title="Modifier">
                                                            <i class="mdi mdi-pencil"></i>
                                                        </a>
                                                        <a href="{{ path('admin_reclamation_delete', {'id': reclamation.id}) }}" 
                                                           class="btn btn-sm btn-outline-danger"
                                                           title="Supprimer"
                                                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?')">
                                                            <i class="mdi mdi-delete"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                                {% else %}
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted">Aucune réclamation récente</td>
                                                </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Graphique de répartition par statut
    const statusData = {{ stats.byStatus|json_encode|raw }};
    if (statusData.length > 0) {
        const statusCtx = document.getElementById('statusChart');

        const getColorByStatus = (status) => {
            switch (status.toLowerCase()) {
                case 'nouvelle':
                    return '#FFC100'; // Jaune
                case 'en cours':
                    return '#FFA500'; // Orange
                case 'rejetée':
                    return '#FF4747'; // Rouge
                case 'traitée':
                    return '#57B657'; // Vert
                default:
                    return '#00B5AD'; // Couleur par défaut
            }
        };

        const labels = statusData.map(s => s.etat);
        const data = statusData.map(s => s.count);
        const backgroundColors = statusData.map(s => getColorByStatus(s.etat));

        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: backgroundColors,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const value = context.raw;
                                const percentage = Math.round((value / total) * 100);
                                return `${context.label}: ${value} (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // Graphique circulaire mensuel
    const monthlyPieCtx = document.getElementById('monthlyPieChart').getContext('2d');
    const monthlyPieChart = new Chart(monthlyPieCtx, {
        type: 'pie',
        data: {
            labels: {{ stats.monthlyTrend|map(t => t.month)|json_encode|raw }},
            datasets: [{
                data: {{ stats.monthlyTrend|map(t => t.count)|json_encode|raw }},
                backgroundColor: [
                    '#4B49AC', '#FFC100', '#57B657', '#FF4747', '#00B5AD',
                    '#7C4DFF', '#F06292', '#4DD0E1', '#F57C00', '#8BC34A',
                    '#E91E63', '#607D8B'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'right',
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const value = context.raw;
                            const percentage = Math.round((value / total) * 100);
                            return `${context.label}: ${value} (${percentage}%)`;
                        }
                    }
                }
            }
        }
    });

    // Graphique d'évolution mensuelle
    const trendData = {{ stats.monthlyTrend|json_encode|raw }};
    if (trendData.length > 0) {
        const trendCtx = document.getElementById('monthlyTrendChart');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: trendData.map(t => t.month),
                datasets: [{
                    label: 'Nombre de réclamations',
                    data: trendData.map(t => t.count),
                    backgroundColor: 'rgba(75, 73, 172, 0.2)',
                    borderColor: 'rgba(75, 73, 172, 1)',
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
    }
});
</script>
{% endblock %}
