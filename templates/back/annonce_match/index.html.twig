{% extends 'annonce_match/base.html.twig' %}

{% block title %}Annonces{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des Annonces</h1>
        <a href="{{ path('app_annonce_match_new') }}" class="btn btn-success">
            <i class="fas fa-plus"></i> Créer une nouvelle annonce
        </a>
    </div>

    {# Debug Information #}
    <div class="card mb-4">
        <div class="card-header">
            <h3>Debug Information</h3>
        </div>
        <div class="card-body">
            <p><strong>Total Announcements:</strong> {{ debug_info.total_annonces }}</p>
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Owner ID</th>
                        <th>Owner Email</th>
                    </tr>
                </thead>
                <tbody>
                    {% for annonce in debug_info.annonces %}
                        <tr>
                            <td>{{ annonce.id }}</td>
                            <td>{{ annonce.titre }}</td>
                            <td>{{ annonce.user_id }}</td>
                            <td>{{ annonce.user_email }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Date</th>
                    <th>Lieu</th>
                    <th>Joueurs Recherchés</th>
                    <th>Niveau</th>
                    <th>Description</th>
                    <th>Propriétaire</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for annonce_match in annonce_matches %}
                <tr>
                    <td>{{ annonce_match.titre }}</td>
                    <td>{{ annonce_match.dateHeure ? annonce_match.dateHeure|date('Y-m-d') : '' }}</td>
                    <td>{{ annonce_match.lieu }}</td>
                    <td>{{ annonce_match.joueursRecherches }}</td>
                    <td>{{ annonce_match.niveau }}</td>
                    <td>{{ annonce_match.description }}</td>
                    <td>{{ annonce_match.user ? annonce_match.user.getEmail() : 'N/A' }}</td>
                    <td>
                        <a href="{{ path('app_annonce_match_show', {'annonceId': annonce_match.annonceId}) }}" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="{{ path('app_annonce_match_edit', {'annonceId': annonce_match.annonceId}) }}" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="{{ path('app_demande_new', {'annonceId': annonce_match.annonceId}) }}" class="btn btn-primary btn-sm">
                            <i class="fas fa-handshake"></i> Faire une demande
                        </a>
                        <form method="post" action="{{ path('app_annonce_match_delete', {'annonceId': annonce_match.annonceId}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette annonce?');" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ annonce_match.annonceId) }}">
                            <button class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center">Aucune annonce trouvée</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %} 