{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<style>
.profile-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    border-radius: 15px;
    overflow: hidden;
    max-width: 500px;
    margin: auto;
    color: #fff;
    text-align: center;
    padding: 30px;
    transition: transform 0.3s ease-in-out;
}
.profile-card:hover {
    transform: scale(1.02);
}
.profile-card img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid white;
    margin-bottom: 20px;
}
.profile-card h3 {
    font-weight: 600;
    margin-bottom: 10px;
}
.profile-card p {
    font-size: 16px;
}
.btn-edit {
    margin-top: 20px;
}
</style>

<div class="profile-card mt-5">
    <img src="{{ asset('uploads/avatars/' ~ profil.avatar) }}" alt="Avatar de {{ profil.user.prenom }}">
    <h3>{{ profil.user.nom }} {{ profil.user.prenom }}</h3>
    <p class="fst-italic">{{ profil.bio ?: 'Aucune biographie renseignée.' }}</p>
    
    <a href="{{ path('app_profil_edit_front', {'id': profil.id}) }}" class="btn btn-primary me-2">
        <i class="fas fa-edit"></i> Modifier mon profil
    </a>
    <form method="post" action="{{ path('app_profil_delete', {'id': profil.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre profil ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ profil.id) }}">
    <button class="btn btn-danger mt-3" type="submit">
        <i class="fas fa-trash-alt"></i> Supprimer mon profil
    </button>
</form>

</div>
{% endblock %}
