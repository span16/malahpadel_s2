{% extends 'back.html.twig' %}

{% block title %}Créer un profil{% endblock %}

{% block body %}
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm p-4">
        <h3 class="text-center text-primary mb-4">Créer un profil utilisateur</h3>

        {% for flash in app.flashes('danger') %}
          <div class="alert alert-danger">{{ flash }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'row g-4', 'enctype': 'multipart/form-data'}}) }}

        <div class="col-12">
          {{ form_label(form.avatar) }}
          {{ form_widget(form.avatar, {'attr': {'class': 'form-control'}}) }}
          {{ form_errors(form.avatar) }}
        </div>

        <div class="col-12">
          {{ form_label(form.bio) }}
          {{ form_widget(form.bio, {'attr': {'class': 'form-control', 'rows': 4}}) }}
          {{ form_errors(form.bio) }}
        </div>

        <div class="col-12">
          {{ form_label(form.preferences) }}
          {{ form_widget(form.preferences, {'attr': {'class': 'form-control'}}) }}
          {{ form_errors(form.preferences) }}
        </div>

        <div class="col-12 d-flex justify-content-between mt-4">
          <a href="{{ path('app_user_dashboard') }}" class="btn btn-secondary">← Retour</a>
          <button type="submit" class="btn btn-success">✅ Créer</button>
        </div>

        {{ form_end(form) }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
