{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<style>
    .edit-card {
        background: linear-gradient(135deg, #f5f5f5, #ffffff);
        border: 1px solid #dee2e6;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        max-width: 550px;
        margin: 60px auto;
        padding: 30px;
        font-family: 'Segoe UI', sans-serif;
        color: #333;
    }

    .edit-card h2 {
        text-align: center;
        margin-bottom: 30px;
        color: #0d6efd;
    }

    .edit-card .form-control {
        border-radius: 8px;
    }

    .edit-card .current-avatar {
        display: block;
        margin: 0 auto 25px;
        width: 130px;
        height: 130px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #0d6efd;
        box-shadow: 0 0 10px rgba(13, 110, 253, 0.3);
    }

    .edit-card .btn {
        width: 100%;
        border-radius: 10px;
        padding: 12px;
        font-weight: 500;
    }
</style>

<div class="edit-card">
    <h2>📝 Modifier mon profil</h2>

    {% if profil.avatar %}
        <img src="{{ asset('uploads/avatars/' ~ profil.avatar) }}" alt="Avatar actuel" class="current-avatar">
    {% endif %}

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

        <div class="mb-3">
            {{ form_label(form.avatar, 'Nouvel avatar', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.avatar, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.avatar) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.bio, 'Biographie', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.bio, {'attr': {'class': 'form-control', 'placeholder': 'Parlez-nous un peu de vous...'}}) }}
            {{ form_errors(form.bio) }}
        </div>

        <button type="submit" class="btn btn-primary mt-3">
            ✅ Mettre à jour
        </button>

    {{ form_end(form) }}
</div>
{% endblock %}
